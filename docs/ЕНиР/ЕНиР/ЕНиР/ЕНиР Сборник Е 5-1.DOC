5\green255\blue255;\red0\green0\blue128;\red0\green128\blue128;\red0\green128\blue0;\red128\green0\blue128;\red128\green0\blue0;\red128\green128\blue0;\red128\green128\blue128;\red192\green192\blue192;}{\stylesheet{\nowidctlpar\widctlpar\adjustright \f1\fs18\lang1049\cgrid \snext0 Обычный;}{\*\cs10 \additive Основной шрифт;}{\s15\nowidctlpar\widctlpar\adjustright \b\f1\fs22\lang1049\cgrid \snext15 Heading;}}{\*\revtbl {Unknown;}}{\info{\title ЕНиР Сборник Е5-1}{\author Благий Андрей Владимирович}{\operator User}{\creatim\yr2001\mo5\dy25\hr18\min54}{\revtim\yr2003\mo4\dy6\hr15\min17}{\version3}{\edmins1}{\nofpages23}{\nofwords5499}{\nofchars31346}{\*\company СНИиП}{\nofcharsws38495}{\vern73}}\widowctrl\ftnbj\aenddoc\noxlattoyen\expshrtn\noultrlspc\dntblnsbdb\nospaceforul\lytprtmet\hyphcaps0\formshade\viewkind1\viewscale100\pgbrdrhead\pgbrdrfoot \fet0\sectd \linex0\headery709\footery709\colsx709\sectdefaultcl {\*\pnseclvl1\pnucrm\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl2\pnucltr\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl3\pndec\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl4\pnlcltr\pnstart1\pnindent720\pnhang{\pntxta )}}{\*\pnseclvl5\pndec\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl6\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl7\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl8\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl9\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}\pard\plain \s15\qc\nowidctlpar\widctlpar\adjustright \b\f1\fs22\lang1049\cgrid {\f69 ЕДИНЫЕ НОРМЫ И РАСЦЕНКИ НА СТРОИТЕЛЬНЫЕ, МОНТАЖНЫЕ И РЕМОНТНО-СТРОИТЕЛЬНЫЕ РАБОТЫ
\par }\pard \s15\qc\nowidctlpar\widctlpar\adjustright {\f0 
\par }{\f69 Сборник Е5
\par }{\f0 
\par }{\f69 Монтаж металлических конструкций
\par }{\f0 
\par }{\f69 Выпуск 1
\par }{\f0 
\par }{\f69 ЗДАНИЯ И ПРОМЫШЛЕННЫЕ СООРУЖЕНИЯ
\par }{\f0 
\par 
\par }\pard\plain \qj\fi225\nowidctlpar\widctlpar\adjustright \f1\fs18\lang1049\cgrid {\f69 УТВЕРЖДЕНЫ постановлением Государственного строительного комитета СССР, Государственного комитета СССР по труду и социальным вопросам и Секретариата Всесоюзного Центрального Совета Профессиональных Союзов от 5 декабря 1986 года № 43/512/29-50 для обязательного применения на строительных, монтажных и ремонтно-строительных работах.
\par }{\f0 
\par }{\f69 РАЗРАБОТАНЫ Центральным нормативно-исследовательским бюро (ЦНИБ) и Нормативно-исследовательской станцией № 5 при тресте "Стальмонтаж" Министерства монтажных и специальных строительных работ СССР с использованием нормативных материалов других министерств и ведомств под методическим руководством и при участии Центрального бюро нормативов по труду в строительстве (ЦБНТС) при Всесоюзном научно-исследовательском и проектном институте труда в строительстве Госстроя СССР.
\par }{\f0 
\par }{\f69 Технология производства работ, предусмотренная в сборнике, согласована с Всесоюзным научно-исследовательским проектным институтом "Промстальконструкция".
\par }\pard \qj\fi540\nowidctlpar\widctlpar\adjustright {\f0 
\par 
\par }\pard\plain \s15\qc\nowidctlpar\widctlpar\adjustright \b\f1\fs22\lang1049\cgrid {\f69 ВВОДНАЯ ЧАСТЬ
\par }{\f0 
\par }\pard\plain \qj\fi225\nowidctlpar\widctlpar\adjustright \f1\fs18\lang1049\cgrid {\f69 1. Выпуск содержит нормы и расценки на работы по монтажу металлических конструкций промышленных зданий и сооружений различного назначения.
\par }{\f0 
\par }{\f69 2. Нормы предусматривают выполнение монтажных работ с соблюдением требований к качеству выполняемых работ, в соответствии со СНиП III-18-75 "Металлические конструкции".
\par }{\f0 
\par }{\f69 Рабочие обязаны знать и выполнять все требования, предусмотренные выпуском норм, регламентированные вышеуказанным СНиП.
\par }{\f0 
\par }{\f69 Рабочие обязаны знать и соблюдать правила техники безопасности при выполнении работ согласно требованиям СНиП III-4-80 "Техника безопасности в строительстве".
\par }{\f0 
\par }{\f69 Нормами предусмотрен монтаж конструкций башенными, козловыми и гусеничными кранами различной грузоподъемности, а также монтажными кранами на рельсовом ходу, кроме особо оговоренных случаев. При монтаже конструкций автомобильными и пневмоколесными кранами Н.вр. и Расц. следует умножать на 1,1 (ВЧ-1).
\par }{\f0 
\par }{\f69 3. При изменении условий производства монтажных работ, предусмотренных в выпуске, следует применять коэффициенты, приведенные в таблице.
\par }\pard \qr\nowidctlpar\widctlpar\adjustright {\f0 
\par }\trowd \trgaph105 \clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx3225\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx8520\pard \qc\nowidctlpar\widctlpar\intbl\adjustright {\f69 Условия производства монтажных работ, предусмотренные нормами \cell Коэффициенты к Н.вр. и Расц. на фактические условия производства работ при помощи \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f0\fs20 \row }\trowd \trgaph105 \clvertalt\clbrdrl\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx3225\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx4500\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx6237\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx7335\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrb\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx8520\pard \nowidctlpar\widctlpar\intbl\adjustright {\f0 \cell }\pard \qc\nowidctlpar\widctlpar\intbl\adjustright {\f69 кранов \cell электролебедок \cell }\pard \qc\nowidctlpar\widctlpar\intbl\adjustright {\f69 ручных лебедок \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f0 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f0\fs20 \row }\trowd \trgaph105 \clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx3225\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx4500\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx6237\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx7335\clvertalt\clbrdrt\brdrs\brdrw15 \clbrdrl\brdrs\brdrw15 \clbrdrr\brdrs\brdrw15 \cltxlrtb \cellx8520\pard \nowi